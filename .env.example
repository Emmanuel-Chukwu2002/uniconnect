# Copy this file to .env (next to manage.py) and fill it in. Never commit .env.

# PostgreSQL (leave DB_NAME out to use the SQLite file db.sqlite3 instead)
DB_NAME=uniconnect
DB_USER=uniconnect_user
DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ImageKit (photos and videos)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Email for sign-up codes and password resets (Gmail app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# "Continue with Google" sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
